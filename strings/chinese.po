#. STRINGS.UI.SANDBOXMENU.ADVENTURECHAPTER
#, lua-format
msgctxt "STRINGS.UI.SANDBOXMENU.ADVENTURECHAPTER"
msgid "Chapter %d of %d"
msgstr "第%d/%d章"

#. STRINGS.UI.ADVENTUREMODE_PRESENTATION_WAIT.TITLE
msgctxt "STRINGS.UI.ADVENTUREMODE_PRESENTATION_WAIT.TITLE"
msgid "Waiting for Other Players"
msgstr "正在等待其他玩家"

#. STRINGS.UI.ADVENTUREMODE_PRESENTATION_WAIT.PROGRESS
#, lua-format
msgctxt "STRINGS.UI.ADVENTUREMODE_PRESENTATION_WAIT.PROGRESS"
msgid "Players ready: %d / %d\n%s"
msgstr "已准备：%d / %d\n%s"

#. STRINGS.UI.WORLDRESETDIALOG.REGEN_MSG_ADVENTURE
#, lua-format
msgctxt "STRINGS.UI.WORLDRESETDIALOG.REGEN_MSG_ADVENTURE"
msgid "Everyone is dead. Everyone will return to the main world in: %d"
msgstr "所有人都已死亡。%d 秒后返回原来的主世界"

#. STRINGS.UI.WORLDRESETDIALOG.RESET_BUTTON_ADVENTURE
#, lua-format
msgctxt "STRINGS.UI.WORLDRESETDIALOG.RESET_BUTTON_ADVENTURE"
msgid "Return Now"
msgstr "立即返回"

#. STRINGS.UI.HUD.TELEPORTATO_PLAYER_CONFIRMED
#, lua-format
msgctxt "STRINGS.UI.HUD.TELEPORTATO_PLAYER_CONFIRMED"
msgid "Player %s has confirmed."
msgstr "玩家 %s 已确认"

#. STRINGS.UI.HUD.TELEPORTATO_ADVENTURE_INACTIVE
msgctxt "STRINGS.UI.HUD.TELEPORTATO_ADVENTURE_INACTIVE"
msgid "The Adventure run is no longer active."
msgstr "当前冒险流程已结束。"

#. STRINGS.UI.HUD.TELEPORTATO_INCOMPLETE
msgctxt "STRINGS.UI.HUD.TELEPORTATO_INCOMPLETE"
msgid "The Teleportato is incomplete."
msgstr "传送基座尚未完整组装。"

#. STRINGS.UI.HUD.TELEPORTATO_TRANSITION_FAILED
msgctxt "STRINGS.UI.HUD.TELEPORTATO_TRANSITION_FAILED"
msgid "Unable to travel to the next chapter. Try again."
msgstr "无法前往下一章节，请重试。"

#. STRINGS.UI.WORLDRESETDIALOG.ADVENTURE_RETURN_CONFIRM_TITLE
msgctxt "STRINGS.UI.WORLDRESETDIALOG.ADVENTURE_RETURN_CONFIRM_TITLE"
msgid "Return to the Original World"
msgstr "返回原来的主世界"

#. STRINGS.UI.WORLDRESETDIALOG.ADVENTURE_RETURN_CONFIRM_BODY
msgctxt "STRINGS.UI.WORLDRESETDIALOG.ADVENTURE_RETURN_CONFIRM_BODY"
msgid "Are you sure you want to return to the original world?"
msgstr "确定要返回原来的主世界吗？"

#. STRINGS.UI.WORLDRESETDIALOG.ADVENTURE_NEXT_CHAPTER_CONFIRM_TITLE
msgctxt "STRINGS.UI.WORLDRESETDIALOG.ADVENTURE_NEXT_CHAPTER_CONFIRM_TITLE"
msgid "The current world will be destroyed, begin the next Adventure Mode chapter? Every living player must confirm activation."
msgstr "当前世界即将毁灭，是否开启下一章节？所有存活玩家必须确认激活。"

#. STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.PRETTYNAME
msgctxt "STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.PRETTYNAME"
msgid "Enter Adventure Mode"
msgstr "进入冒险模式"

#. STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.DESC
msgctxt "STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.DESC"
msgid "Vote to enter Adventure Mode."
msgstr "投票进入冒险模式。"

#. STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTETITLEFMT
msgctxt "STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTETITLEFMT"
msgid "Enter Adventure Mode?"
msgstr "是否进入冒险模式？"

#. STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTENAMEFMT
msgctxt "STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTENAMEFMT"
msgid "vote to enter Adventure Mode"
msgstr "进入冒险模式的投票"

#. STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTEPASSEDFMT
msgctxt "STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTEPASSEDFMT"
msgid "Entering Adventure Mode in 5 seconds..."
msgstr "将在5秒后进入冒险模式……"

#. STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTEFAILEDFMT
msgctxt "STRINGS.UI.BUILTINCOMMANDS.ADVENTUREMODE_ENTER.VOTEFAILEDFMT"
msgid "The vote to enter Adventure Mode has failed."
msgstr "进入冒险模式的投票未通过。"

#. STRINGS.UI.ADVENTUREMODE_VOTE.ACTIVE
msgctxt "STRINGS.UI.ADVENTUREMODE_VOTE.ACTIVE"
msgid "Another vote is already in progress."
msgstr "已有一项投票正在进行。"

#. STRINGS.UI.ADVENTUREMODE_VOTE.ALREADY_ACTIVE
msgctxt "STRINGS.UI.ADVENTUREMODE_VOTE.ALREADY_ACTIVE"
msgid "Adventure Mode is already active."
msgstr "冒险模式已经开始。"

#. STRINGS.UI.ADVENTUREMODE_VOTE.FAILED
msgctxt "STRINGS.UI.ADVENTUREMODE_VOTE.FAILED"
msgid "Unable to start the Adventure Mode vote."
msgstr "无法发起进入冒险模式的投票。"

#. STRINGS.UI.ADVENTUREMODE_VOTE.MASTER_ONLY
msgctxt "STRINGS.UI.ADVENTUREMODE_VOTE.MASTER_ONLY"
msgid "The Adventure Mode vote must be started from the Master world."
msgstr "只能在主世界发起进入冒险模式的投票。"

#. STRINGS.UI.ADVENTUREMODE_VOTE.PENDING
msgctxt "STRINGS.UI.ADVENTUREMODE_VOTE.PENDING"
msgid "An Adventure Mode vote is already being started."
msgstr "进入冒险模式的投票正在发起。"

#. STRINGS.UI.ADVENTUREMODE_VOTE.TOO_FAR
msgctxt "STRINGS.UI.ADVENTUREMODE_VOTE.TOO_FAR"
msgid "Move closer to the Adventure Portal."
msgstr "请靠近冒险之门。"

#. STRINGS.UI.PLAYERSTATUSSCREEN.VOTECANNOTSTART.ADVENTUREMODE
msgctxt "STRINGS.UI.PLAYERSTATUSSCREEN.VOTECANNOTSTART.ADVENTUREMODE"
msgid "The Adventure Mode vote is no longer available."
msgstr "当前无法发起进入冒险模式的投票。"

#. STRINGS.UI.ENDGAME.BODY1
msgctxt "STRINGS.UI.ENDGAME.BODY1"
msgid "And so the cycle continues. Will "
msgstr "于是轮回又将开始。"

#. STRINGS.UI.ENDGAME.BODY2
#, lua-format
msgctxt "STRINGS.UI.ENDGAME.BODY2"
msgid " ever escape?\n Perhaps %s too will tire of this wretched place, and use %s new powers to tempt the unsuspecting.\n\nThe mysterious beings that control this place still lurk in the shadows, and new challenges will soon be revealed.\n\n\nUntil then,\n- The Don't Starve Team -"
msgstr "能够逃脱吗？\n或许%s也会对这个不幸的地方感到厌倦，并运用%s新力量来诱惑不知情的人上钩。\n\n掌控此地的神秘生物仍潜伏在阴影中，新的挑战即将揭晓。\n\n\n直到那时，\n-《饥荒》团队 -"

#. STRINGS.UI.ENDGAME.TITLE
msgctxt "STRINGS.UI.ENDGAME.TITLE"
msgid "The End."
msgstr "剧终。"

#. STRINGS.UI.ENDGAME.YES
msgctxt "STRINGS.UI.ENDGAME.YES"
msgid "For Science!"
msgstr "为了科学！"

